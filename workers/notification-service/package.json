{
  "name": "icreatepdf-notifications",
  "version": "1.0.0",
  "description": "Serverless Push Notification Backend for iCreatePDF using Cloudflare Workers & D1",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute icreatepdf-notifications-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute icreatepdf-notifications-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}
